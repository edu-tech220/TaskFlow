{
  "info": {
    "_postman_id": "71bd803c-a417-53eb-b1f3-6e800e0762d2",
    "name": "TaskFlow API",
    "description": "Pruebas end-to-end de TaskFlow. Ejecutar en orden (Runner o newman) contra una base vacía.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Setup",
      "item": [
        {
          "name": "Obtener 'hoy' desde la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/calendar?year=2026&month=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "calendar"
              ],
              "query": [
                {
                  "key": "year",
                  "value": "2026"
                },
                {
                  "key": "month",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const today = pm.response.json().today;",
                  "const add = (d, n) => { const x = new Date(d + 'T00:00:00Z'); x.setUTCDate(x.getUTCDate() + n); return x.toISOString().slice(0, 10); };",
                  "pm.collectionVariables.set('today', today);",
                  "pm.collectionVariables.set('yesterday', add(today, -1));",
                  "pm.collectionVariables.set('tomorrow', add(today, 1));",
                  "pm.collectionVariables.set('weekAgo', add(today, -7));",
                  "pm.collectionVariables.set('year', today.slice(0, 4));",
                  "pm.collectionVariables.set('month', String(parseInt(today.slice(5, 7), 10)));",
                  "pm.test('today tiene formato ISO', () => pm.expect(today).to.match(/^\\d{4}-\\d{2}-\\d{2}$/));"
                ]
              }
            }
          ]
        }
      ]
    },
