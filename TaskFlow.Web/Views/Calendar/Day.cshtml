@model DayViewModel
@{
    var day = Model.Day;
    var date = day.Date.ToString("yyyy-MM-dd");
    var (dayLabel, dayCss) = Display.Of(day.Status);
    ViewData["Title"] = Display.LongDate(day.Date);
}

<a class="btn btn-link px-0" asp-action="Index" asp-route-year="@day.Date.Year" asp-route-month="@day.Date.Month">&larr; @Display.MonthTitle(day.Date.Year, day.Date.Month)</a>

<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <h1 class="h3 m-0">@Display.LongDate(day.Date)</h1>
    <span class="legend @dayCss">@dayLabel</span>
    @if (day.Date == Model.Today) { <span class="badge text-bg-dark">Hoy</span> }
</div>

<div class="row g-2 mb-4 text-center">
    <div class="col"><div class="border rounded p-2"><div class="fs-4">@day.ScheduledCount</div><small>Programadas</small></div></div>
    <div class="col"><div class="border rounded p-2"><div class="fs-4 text-success">@day.CompletedCount</div><small>Completadas</small></div></div>
    <div class="col"><div class="border rounded p-2"><div class="fs-4 text-danger">@day.NotCompletedCount</div><small>No completadas</small></div></div>
    <div class="col"><div class="border rounded p-2"><div class="fs-4 text-warning">@day.PendingCount</div><small>Pendientes</small></div></div>
    <div class="col"><div class="border rounded p-2"><div class="fs-4 text-secondary">@day.UnrecordedCount</div><small>Sin registro</small></div></div>
</div>

@* ---------- Descanso ---------- *@
<div class="card mb-4">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        @if (day.IsRestDay)
        {
            <span>Este día está marcado como <strong>descanso</strong>.</span>
            @if (Model.CanToggleRestDay)
            {
                <form asp-action="RemoveRestDay" method="post">
                    <input type="hidden" name="date" value="@date" />
                    <button class="btn btn-sm btn-outline-danger">Quitar descanso</button>
                </form>
            }
        }
        else if (Model.CanToggleRestDay)
        {
            <form asp-action="AddRestDay" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                <input type="hidden" name="date" value="@date" />
                <input type="text" name="notes" maxlength="200" class="form-control form-control-sm" placeholder="Nota (opcional)" style="max-width: 16rem" />
                <button class="btn btn-sm btn-primary">Marcar como descanso</button>
            </form>
            <small class="text-muted">Usados este mes: @Model.RestDaysUsed / @Model.RestDayLimit</small>
        }
        else
        {
            <span class="text-muted">Los descansos solo se marcan o quitan de hoy en adelante.</span>
        }
    </div>
</div>

@* ---------- Actividades del día ---------- *@
<h2 class="h5">Actividades</h2>
@if (day.Activities.Count == 0)
{
    <p class="text-muted">No hay actividades programadas este día.</p>
}

<div class="list-group">
    @foreach (var a in day.Activities)
    {
        var (label, badge) = Display.Of(a.Status);
        var hasRecord = a.Status is ActivityDayStatus.Completed or ActivityDayStatus.NotCompleted;
        <div class="list-group-item">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <strong>@a.Name</strong>
                    <span class="text-muted ms-2">@Display.Time(a.StartTime)–@Display.Time(a.EndTime)</span>
                    @if (a.ActualEndTime is { } end) { <span class="text-muted ms-2">(terminó @Display.Time(end))</span> }
                    @if (!string.IsNullOrEmpty(a.Notes)) { <div class="small text-muted">@a.Notes</div> }
                </div>
                <span class="badge @badge">@label</span>
            </div>

            @if (Model.CanRecord)
            {
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <form asp-action="Record" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                        <input type="hidden" name="activityId" value="@a.ActivityId" />
                        <input type="hidden" name="date" value="@date" />
                        <input type="hidden" name="status" value="Completed" />
                        <input type="time" name="actualEndTime" class="form-control form-control-sm" value="@(a.ActualEndTime?.ToString("HH:mm"))" title="Hora real de término (opcional)" />
                        <input type="text" name="notes" maxlength="500" class="form-control form-control-sm" placeholder="Nota" value="@a.Notes" />
                        <button class="btn btn-sm btn-success">Completada</button>
                    </form>
                    <form asp-action="Record" method="post">
                        <input type="hidden" name="activityId" value="@a.ActivityId" />
                        <input type="hidden" name="date" value="@date" />
                        <input type="hidden" name="status" value="NotCompleted" />
                        <input type="hidden" name="notes" value="@a.Notes" />
                        <button class="btn btn-sm btn-outline-danger">No completada</button>
                    </form>
                    @if (hasRecord)
                    {
                        <form asp-action="DeleteRecord" method="post">
                            <input type="hidden" name="activityId" value="@a.ActivityId" />
                            <input type="hidden" name="date" value="@date" />
                            <button class="btn btn-sm btn-outline-secondary" title="Corregir: vuelve a pendiente / sin registro">Borrar registro</button>
                        </form>
                    }
                </div>
            }
        </div>
    }
</div>
