@model ActivityFormViewModel
@{
    ViewData["Title"] = "Nueva actividad";
}

<h1 class="h3 mb-3">Nueva actividad</h1>

<form asp-action="Create" method="post" style="max-width: 48rem">
    <partial name="_ActivityForm" model="Model" />
    <button type="submit" class="btn btn-primary">Crear</button>
    <a class="btn btn-link" asp-action="Index">Cancelar</a>
</form>
