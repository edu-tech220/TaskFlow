@model List<ActivityDto>
@{
    ViewData["Title"] = "Actividades";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Actividades</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva actividad</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Aún no hay actividades. Crea la primera.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th>Nombre</th><th>Horario actual</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var s = a.CurrentSchedule;
                    <tr class="@(a.IsActive ? "" : "text-muted")">
                        <td>
                            <strong>@a.Name</strong>
                            @if (!string.IsNullOrEmpty(a.Description)) { <div class="small text-muted">@a.Description</div> }
                        </td>
                        <td>
                            @if (s is not null)
                            {
                                <span>@Display.Time(s.StartTime)–@Display.Time(s.EndTime)</span>
                                <div class="small text-muted">@Display.Days(s.Days)</div>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>
                            @if (a.IsActive)
                            {
                                <span class="badge text-bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactiva</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.Id">Editar</a>
                                <form asp-action="ToggleStatus" asp-route-id="@a.Id" method="post">
                                    <input type="hidden" name="isActive" value="@((!a.IsActive).ToString().ToLowerInvariant())" />
                                    <button class="btn btn-sm btn-outline-warning">@(a.IsActive ? "Desactivar" : "Reactivar")</button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@a.Id" method="post"
                                      onsubmit="return confirm('¿Eliminar &quot;@a.Name&quot;? Solo es posible si no tiene registros.');">
                                    <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
